{
  "name": "miru-light",
  "version": "0.0.34",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190",
    "build": "vite build",
    "worker": "wrangler dev -c wrangler.dev.jsonc --port 8790 --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --test tools/setup.test.mjs",
    "deploy": "node tools/setup.mjs deploy",
    "release-light": "node tools/release-light.mjs",
    "setup": "node tools/setup.mjs"
  },
  "devDependencies": {
    "happy-dom": "20.12.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.151.1"
  }
}
