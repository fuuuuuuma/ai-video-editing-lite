// 自分の Cloudflare に立てる MIRU ライトの設定のひな形（2026-10-22・2026-10-23 にライトの印・容量の上限・新しい版の知らせ）。
// `node tools/setup.mjs` がこれを写して wrangler.jsonc を作り、__ で囲んだ所を埋める。手で直さず、setup.mjs のオプションで変える
{
  "name": "__NAME__",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/m/*", "/auth/*", "/mcp", "/dl/*"] },
  "vars": {
    // MIRU ライト（編集は AI動画編集 lite・MCP の案内と道具が lite 向けになる）
    "MIRU_EDITION": "light",
    // Google でログイン。クライアント ID は公開してよい値。シークレットは `wrangler secret put GOOGLE_CLIENT_SECRET` で入れる（ここには書かない）
    "GOOGLE_CLIENT_ID": "__GOOGLE_CLIENT_ID__",
    // 修正指示を読みやすく整える AI。使えないとき（無料の枠を超えた・有料プランの型など）は文をそのまま返す
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // チャンネルを作れる人（自分のメール。カンマで何人でも）。ほかの人は招待されたチャンネルだけを見る（招待されていない人は入れない）
    "SITE_OWNERS": "__OWNER__",
    "CONTACT_EMAIL": "__OWNER__",
    // 置ける量の上限。R2 の無料の範囲（10GB）を超えて請求されないように、既定は 9GB（9×1024³ バイト）。空なら上限なし（setup.mjs の --owner-quota-gb）
    "OWNER_QUOTA_BYTES": "__OWNER_QUOTA__",
    // 新しい版の知らせ。設定の画面がこれを読んで、今の版と比べる
    "UPDATE_FEED": "__UPDATE_FEED__",
    "AI_DAILY_LIMIT": "200"
  },
  // 毎日の掃除（期限切れのログイン・鍵、上げ終わらない版）。日本時間 4:17
  "triggers": { "crons": ["17 19 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "__NAME__", "database_id": "__DATABASE_ID__", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "__NAME__-media" }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
